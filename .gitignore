# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Firebase / Google service account keys (secrets — never commit)
firebase-adminsdk.json
*-firebase-adminsdk-*.json
firebase_keys.txt

# Android build artifacts
/android/.gradle/
/android/build/
/android/app/.gradle/
/android/app/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Release signing (secrets — never commit)
/android/key.properties
*.jks
*.keystore

# Locally built APKs for manual GitHub Release upload
/dist/
